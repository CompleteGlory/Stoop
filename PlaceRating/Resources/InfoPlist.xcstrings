{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط صورة لمكان أو قائمته لإضافتها إلى Stoop."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of a place or its menu to add it to Stoop."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر موقعك للأصدقاء الذين تقبلهم أثناء فتح التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is shown to friends you accept, while the app is open."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ صور الأماكن والقوائم من Stoop في مكتبتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save place and menu photos from Stoop to your library."
          }
        }
      }
    }
  },
  "version": "1.0"
}
