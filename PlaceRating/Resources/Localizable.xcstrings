{
  "sourceLanguage": "en",
  "strings": {
    "Available": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متاح"
          }
        }
      }
    },
    "By continuing you accept the Terms and Privacy Policy.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بالمتابعة فإنك توافق على الشروط وسياسة الخصوصية."
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التحقق…"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متابعة"
          }
        }
      }
    },
    "Pick your name": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اسمك"
          }
        }
      }
    },
    "Sign in failed. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تسجيل الدخول. حاول مرة أخرى."
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الخروج"
          }
        }
      }
    },
    "Something went wrong. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما. حاول مرة أخرى."
          }
        }
      }
    },
    "That username is taken.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم هذا مأخوذ."
          }
        }
      }
    },
    "That username isn't available.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم هذا غير متاح."
          }
        }
      }
    },
    "This is how friends see you on the map.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هكذا يراك أصدقاؤك على الخريطة."
          }
        }
      }
    },
    "Too many attempts. Try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة جدًا. حاول لاحقًا."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول مرة أخرى"
          }
        }
      }
    },
    "Use 3 to 20 letters, digits, _ or .": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم من 3 إلى 20 حرفًا إنجليزيًا أو رقمًا أو _ أو ."
          }
        }
      }
    },
    "Use a different Apple ID": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم حساب Apple آخر"
          }
        }
      }
    },
    "We couldn't reach the server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم."
          }
        }
      }
    },
    "Your friends, your places, one map": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصدقاؤك وأماكنك على خريطة واحدة"
          }
        }
      }
    },
    "Your session has expired. Sign in again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلستك. سجّل الدخول مرة أخرى."
          }
        }
      }
    }
  },
  "version": "1.0"
}
