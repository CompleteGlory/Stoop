{
  "sourceLanguage": "en",
  "strings": {
    "Available": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متاح"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التحقق…"
          }
        }
      }
    },
    "Choose a username": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر اسم مستخدم"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متابعة"
          }
        }
      }
    },
    "Friends find you by this name.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجدك أصدقاؤك بهذا الاسم."
          }
        }
      }
    },
    "Rate places with your friends": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيّم الأماكن مع أصدقائك"
          }
        }
      }
    },
    "Sign in failed. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تسجيل الدخول. حاول مرة أخرى."
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الخروج"
          }
        }
      }
    },
    "Something went wrong. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما. حاول مرة أخرى."
          }
        }
      }
    },
    "That username is taken.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم هذا مأخوذ."
          }
        }
      }
    },
    "That username isn't available.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم هذا غير متاح."
          }
        }
      }
    },
    "Too many attempts. Try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة جدًا. حاول لاحقًا."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول مرة أخرى"
          }
        }
      }
    },
    "Use 3 to 20 letters, digits, _ or .": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم من 3 إلى 20 حرفًا إنجليزيًا أو رقمًا أو _ أو ."
          }
        }
      }
    },
    "Username": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم"
          }
        }
      }
    },
    "We couldn't reach the server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم."
          }
        }
      }
    },
    "Your session has expired. Sign in again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلستك. سجّل الدخول مرة أخرى."
          }
        }
      }
    }
  },
  "version": "1.0"
}
