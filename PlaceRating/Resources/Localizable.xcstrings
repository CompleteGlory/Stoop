      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإعدادات"
          }
        }
      }
    },
    "Sharing with %lld friends": {
      "localizations": {
        "ar": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "مشاركة مع %lld أصدقاء"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "مشاركة مع %lld صديقًا"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "مشاركة مع صديق واحد"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "مشاركة مع %lld صديق"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "مشاركة مع صديقين"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا تشارك موقعك مع أحد"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sharing with %lld friend"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sharing with %lld friends"
                }
              }
            }
          }
        }
      }
    },
    "Show friends where you are?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد أن يرى أصدقاؤك مكانك؟"
          }
        }
      }
    },
    "Sign in failed. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تسجيل الدخول. حاول مرة أخرى."
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الخروج"
          }
        }
      }
    },
    "Skin": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البشرة"
          }
        }
      }
    },
    "Something went wrong. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما. حاول مرة أخرى."
          }
        }
      }
    },
    "Style": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النمط"
          }
        }
      }
    },
    "Surprise me": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فاجئني"
          }
        }
      }
    },
    "That character couldn't be saved. Try another look.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ الشخصية. جرّب مظهرًا آخر."
          }
        }
      }
    },
    "That username is taken.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم هذا مأخوذ."
          }
        }
      }
    },
    "That username isn't available.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم هذا غير متاح."
          }
        }
      }
    },
    "This is how friends see you on the map.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هكذا يراك أصدقاؤك على الخريطة."
          }
        }
      }
    },
    "Too many attempts. Try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة جدًا. حاول لاحقًا."
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول مرة أخرى"
          }
        }
      }
    },
    "Turn on location": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفعيل الموقع"
          }
        }
      }
    },
    "Turn on location to share with friends": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الموقع لتشاركه مع أصدقائك"
          }
        }
      }
    },
    "Use 3 to 20 letters, digits, _ or .": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم من 3 إلى 20 حرفًا إنجليزيًا أو رقمًا أو _ أو ."
          }
        }
      }
    },
    "Use a different Apple ID": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم حساب Apple آخر"
          }
        }
      }
    },
    "We couldn't reach the server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم."
          }
        }
      }
    },
    "You": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت"
          }
        }
      }
    },
    "Your friends, your places, one map": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصدقاؤك وأماكنك على خريطة واحدة"
          }
        }
      }
    },
    "Your location is shown to friends you accept, while the app is open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر موقعك للأصدقاء الذين تقبلهم أثناء فتح التطبيق."
          }
        }
      }
    },
    "Your session has expired. Sign in again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلستك. سجّل الدخول مرة أخرى."
          }
        }
      }
    }
  },
  "version": "1.0"
}
